# Copy to .env. AI provider and storage settings are optional; leave provider keys empty
# to use local hashing embeddings, the rule-based analyst, and the in-memory store.

# Chat model (any OpenAI-compatible endpoint with tool calling). Groq free tier example:
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Embeddings (any OpenAI-compatible /embeddings endpoint). Gemini free tier example:
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Storage: memory (default) or mongo (MongoDB Atlas Vector Search)
STORE_TYPE=memory
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/incident_copilot?retryWrites=true&w=majority

# Exact browser origin(s) allowed to call the API; comma-separated when needed.
# CORS_ALLOWED_ORIGINS=https://incident-copilot-ui.onrender.com

# Required for single-admin login. Store the BCrypt hash, never the raw password.
AUTH_ADMIN_EMAIL=
AUTH_ADMIN_PASSWORD_HASH=
# Base64-encoded random key containing at least 32 bytes.
AUTH_JWT_SECRET_BASE64=
